# Generated by Cargo
# will have compiled files and executables
debug
target

# Headless-runner output directory
/out
/out_test
/smoke-out

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
bundled-cores/
qa-out/

# Local runtime state created by development and smoke-test launches.
/retrofeel.db*
/saves/

# Local macOS and packaging artifacts.
.DS_Store
/builds/
/dist/

# Local Steam Deck captures and Python caches from agent-skill validation.
/recordings/steam/
/recordings/analysis/
**/__pycache__/
*.pyc


# Local Google OAuth credentials and environment settings.
.env
.env.*
!.env.example

# Reproducible static website output and deployment state.
/site/public/
/site/resources/
/site/.hugo_build.lock
/site/.wrangler/
/site/node_modules/
/site/worker-configuration.d.ts

/recordings/
/roms/
/states/
/system/
/cores/
/.dex/
/site/.dev.vars*
/site/wrangler.local.jsonc
