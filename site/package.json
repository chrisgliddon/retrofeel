{
  "name": "retrofeel-site",
  "private": true,
  "scripts": {
    "build": "hugo --minify --panicOnWarning",
    "check": "npm run build && node check.mjs && node --test worker.test.mjs && wrangler deploy --dry-run",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8797",
    "check:browser": "node check-browser.mjs",
    "check:contact": "node check-contact.mjs",
    "preview:contact": "wrangler dev --config wrangler.test.jsonc --ip 127.0.0.1 --port 8797",
    "check:a11y": "node check-a11y.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.59.1",
    "wrangler": "4.127.1"
  }
}
